# Google Gemini API Key
# Obtenha em: https://aistudio.google.com/
GEMINI_API_KEY=sua_chave_aqui

# TikTok Content Posting API
# Crie o app em: https://developers.tiktok.com (produto "Content Posting API", escopo video.publish)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=https://seu-dominio.com/tiktok/callback

# Shopee Affiliate Open API
# Cadastro em: https://affiliate.shopee.com.br/open_api (aprovação manual, 3-5 dias úteis)
SHOPEE_AFFILIATE_APP_ID=
SHOPEE_AFFILIATE_APP_SECRET=

# Lomadee (rede de afiliados BR — Americanas, Magalu, Casas Bahia, Netshoes...)
# Cadastro em: https://www.lomadee.com.br/afiliados
LOMADEE_APP_TOKEN=